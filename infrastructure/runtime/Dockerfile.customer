# Context generated by scripts/wingslab-stage-customer.py. No npm install/hooks.
ARG WINGSLAB_NODE_IMAGE=wingslab-node@sha256:75c03198160d884d61ac1609ae3895d10932c0c4a339f4fa4881bb67628123f5
FROM ${WINGSLAB_NODE_IMAGE} AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 CHECKPOINT_DISABLE=1
COPY . .
RUN --network=none WINGSLAB_OFFLINE_BUILD=yes node scripts/wingslab-build.cjs customer
RUN --network=none node -e "require('fs').writeFileSync('wingslab-build.json', JSON.stringify({freshBuild:true,source:'sri-verified-customer-context',role:'customer'}))"

FROM ${WINGSLAB_NODE_IMAGE} AS runtime
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 CHECKPOINT_DISABLE=1 NODE_ENV=production
LABEL org.wingslab.project=wingslab org.wingslab.phase=3 org.wingslab.role=customer
COPY --from=build --chown=1000:1000 /app/package.json /app/wingslab-build.json /app/provision-manifest.json ./
COPY --from=build --chown=1000:1000 /app/node_modules ./node_modules
COPY --from=build --chown=1000:1000 /app/packages/shared ./packages/shared
COPY --from=build --chown=1000:1000 /app/config/wingslab.cjs ./config/wingslab.cjs
COPY --from=build --chown=1000:1000 /app/scripts/wingslab-run.cjs /app/scripts/blocked-operation.cjs ./scripts/
COPY --from=build --chown=1000:1000 /app/packages/web-customer/.next ./packages/web-customer/.next
COPY --from=build --chown=1000:1000 /app/packages/web-customer/public ./packages/web-customer/public
COPY --from=build --chown=1000:1000 /app/packages/web-customer/package.json /app/packages/web-customer/next.config.js ./packages/web-customer/
USER 1000:1000
CMD ["node", "scripts/blocked-operation.cjs"]
