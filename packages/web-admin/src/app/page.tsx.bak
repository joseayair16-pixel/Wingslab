    void loadRestaurants();
    void loadRestaurantOverview();
    void loadRegions();
    void loadCustomerOverview();
    void loadCustomers();
    void loadDriverOverview();
    void loadDrivers();
    void loadPlatformRequests();
  }, [
    loadDriverOverview,
    loadDrivers,
    loadCustomerOverview,
    loadCustomers,
    loadRegions,
    loadRestaurantOverview,
    loadRestaurants,
    loadPlatformRequests,
    token,
