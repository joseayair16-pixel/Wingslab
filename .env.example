# SaDeL Environment Variables

## Node Environment
NODE_ENV=development
# Set to 'true' to enable mock OTP (MOCK_OTP_CODE) in production for initial rollout
# ALLOW_MOCK_OTP_IN_PROD=false

## API Configuration
PORT=3001
API_HOST=0.0.0.0
API_URL=http://localhost:3001

## Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_TYPE=admin

## Database
# For direct connection (default): use connection_limit=20 for higher concurrency
# DATABASE_URL=postgresql://sadel_user:sadel_password_dev@localhost:5432/sadel_db?connection_limit=20
#
# For PgBouncer (recommended for production with >500 concurrent users):
# Use pooled connection mode with pgbouncer=true
# DATABASE_URL=postgresql://sadel_user:sadel_password_dev@localhost:5432/sadel_db?pgbouncer=true&connection_limit=25&pool_timeout=10
#
# Railway Postgres: Use the internal connection string they provide (non-pooled)
# Railway Postgres + PgBouncer addon: Use the pooled URL from the PgBouncer addon
DATABASE_URL=postgresql://sadel_user:sadel_password_dev@localhost:5432/sadel_db

## Redis
REDIS_URL=redis://localhost:6379

## JWT
JWT_SECRET=your_secret_key_change_in_production_immediately
JWT_EXPIRES_IN=24h

## CORS
CORS_ORIGIN=*

## Payment Gateway (Placeholder - implement with your provider)
PAYMENT_GATEWAY_KEY=your_payment_key
PAYMENT_GATEWAY_SECRET=your_payment_secret

## Logging
LOG_LEVEL=info

## Email (OTP por correo - GRATIS y recomendado)
# Con esto el código de verificación llega por correo (no necesitas pagar SMS).
# Si no está configurado, el OTP cae a SMS o a modo simulación.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=SaDeL <no-reply@sadel.mx>

## SMS OTP (360NRS) — opcional, si quieres que el código llegue por SMS
# Usuario y apiPassword de la sección API de 360NRS (dashboard.360nrs.com)
SMS_360NRS_USER=your_360nrs_user
SMS_360NRS_PASSWORD=your_360nrs_api_password
# Remitente que ve el usuario (máx. 11 alfanuméricos o 15 numéricos)
SMS_360NRS_FROM=SADEL
# Solo si tu cuenta usa otro host (raro); por defecto dashboard.360nrs.com
# SMS_360NRS_HOST=https://dashboard.360nrs.com

## Entrega del código OTP
# Sin channel en la petición -> correo primero, SMS como respaldo, simulación en dev.
# El usuario puede elegir canal con "channel": "email" | "sms" en /auth/enviar-codigo.
# ALLOW_MOCK_OTP_IN_PROD=false

## AWS S3 (Optional - for image storage)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=sadel-uploads

## Cloudflare R2 (Image storage - recommended over Cloudinary)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=sadel-images
R2_PUBLIC_URL=https://images.sadel.mx  # Optional, falls back to r2.dev domain if not set

## WhatsApp Integration (Optional)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_account_id
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_TOKEN=your_api_token
# URL del panel del restaurante (web-restaurant) para los links de las notificaciones de WhatsApp
RESTAURANT_PANEL_URL=https://restaurante.pideloporsadel.app

## URL base del frontend (para redes sociales / Open Graph)
NEXT_PUBLIC_SITE_URL=https://pideloporsadel.app

# ORIGEN CANÓNICO DE LA APP DEL COMENSAL (usa en links para compartir tienda, QR de reparto, etc.)
# ⚠️ CRÍTICO: jamas apuntar a un preview de Vercel (*.vercel.app) ni a sadel.app.
# - Backend lee CUSTOMER_WEB_URL (o WEBAPP_URL) para generar QR / links de WhatsApp.
# - web-restaurant lee NEXT_PUBLIC_CUSTOMER_URL para "Copiar link" de la tienda.
CUSTOMER_WEB_URL=https://pideloporsadel.app
WEBAPP_URL=https://pideloporsadel.app
NEXT_PUBLIC_CUSTOMER_URL=https://pideloporsadel.app

## Geolocation & Maps
MAPBOX_TOKEN=your_mapbox_token
GOOGLE_MAPS_API_KEY=your_google_maps_key
