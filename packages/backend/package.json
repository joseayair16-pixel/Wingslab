{
  "name": "@sadel/backend",
  "version": "1.0.0",
  "description": "SaDeL Backend API - Fastify + Node.js",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node ../../scripts/blocked-operation.cjs",
    "build": "tsc && tsc-alias",
    "start": "node ../../scripts/wingslab-run.cjs backend start",
    "lint": "eslint src --ext .ts",
    "db:migrate": "node ../../scripts/blocked-operation.cjs",
    "db:push": "node ../../scripts/blocked-operation.cjs",
    "db:generate": "node ../../scripts/blocked-operation.cjs",
    "db:studio": "node ../../scripts/blocked-operation.cjs",
    "db:backup": "node ../../scripts/blocked-operation.cjs",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.hermetic.config.cjs --runInBand",
    "test:http": "node ../../scripts/blocked-operation.cjs",
    "test:flow": "node ../../scripts/blocked-operation.cjs",
    "test:failures": "node ../../scripts/blocked-operation.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1094.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/client": "^5.7.1",
    "@sadel/shared": "1.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.12.3",
    "firebase-admin": "^14.2.0",
    "ioredis": "^5.3.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.4",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "jest": "^29.7.0",
    "prisma": "^5.7.1",
    "ts-jest": "^29.1.1",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3"
  }
}
