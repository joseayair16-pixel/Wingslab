# EXAMPLE ONLY. Do not create .env/.env.local or reuse SaDeL credentials.
# Reference inventory only. Canonical templates: config/wingslab*.example.json.
# The launcher constructs a clean environment; this file is never loaded.
# Authorization intentionally blank: no execution is authorized by this template.
WINGSLAB_ENVIRONMENT=local
WINGSLAB_RUNTIME_AUTHORIZED=
WINGSLAB_NETWORK_ATTESTED=
WINGSLAB_PROFILE=container
WINGSLAB_INSTANCE_ID=
WINGSLAB_STORAGE_PROVIDER=memory
NODE_ENV=development

# Dedicated resources; placeholders are not usable secrets.
WINGSLAB_DATABASE_URL=
WINGSLAB_REDIS_URL=
WINGSLAB_POSTGRES_PASSWORD=
WINGSLAB_REDIS_PASSWORD=
WINGSLAB_JWT_SECRET=
WINGSLAB_DATABASE_ENCRYPTION_KEY=

NEXT_PUBLIC_API_URL=http://127.0.0.1:3101
NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:3101
NEXT_PUBLIC_CUSTOMER_URL=http://127.0.0.1:3103
# Per frontend process: admin 3100, restaurant 3102, customer 3103, driver 3104.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3103

# External capabilities and jobs are hard-disabled in code in Phase 1.
# Do not populate FIREBASE_*, GOOGLE_APPLICATION_CREDENTIALS, VAPID_*, R2_*,
# WHATSAPP_*, SMS_*, SMTP_*, RESEND_*, AWS_*, CF_* or Google Maps credentials.
