                  className={`flex items-center gap-3 rounded-2xl px-4 py-3 text-left text-sm font-semibold transition ${
                    activeSection === item.key
                      ? 'bg-neutral-950 text-white'
                      : 'text-neutral-700 hover:bg-white'
                  }`}
                >
                  <AdminNavIcon kind={item.key} />
                  {item.label}
                </button>
              ))}
            </nav>
          </div>

          <div className="border-t border-black/5 p-4">
            <button
              type="button"
              onClick={() => clearSession()}
              className="flex w-full items-center gap-3 rounded-2xl px-4 py-3 text-left text-sm font-semibold transition text-rose-600 hover:bg-rose-50"
            >
              <svg className="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
              Cerrar sesión
            </button>
          </div>
        </aside>

        <div className="flex-1 bg-[#f7f4ec] lg:ml-[260px]">
          <div className="p-4 md:p-6">
            {activeSection === 'dashboard' ? (
              <div className="space-y-4 md:space-y-5">
                <section className="overflow-hidden rounded-[32px] border border-black/5 bg-[linear-gradient(180deg,rgba(255,255,255,0.98),rgba(248,246,242,0.96))] p-5 shadow-[0_20px_70px_rgba(15,15,15,0.06)] backdrop-blur md:p-6">
                  <div className="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
                    <div className="max-w-3xl">
                      <p className="text-[11px] font-semibold uppercase tracking-[0.28em] text-neutral-400">
                        SaDeL Admin
                      </p>
                      <h1 className="mt-2 text-[2rem] font-semibold tracking-[-0.05em] text-neutral-950 md:text-[2.3rem]">
                        Consola central para operar restaurantes y regiones
                      </h1>
                      <p className="mt-3 max-w-2xl text-sm leading-6 text-neutral-500">
                        Una vista ejecutiva, compacta y premium para supervisar operaciones, revisar cuentas y mantener orden en toda la red.
                      </p>
                    </div>

                    <div className="w-full max-w-lg rounded-[28px] border border-black/5 bg-white/80 p-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.82)]">
                      <div className="flex items-start justify-between gap-4">
                        <div>
                          <p className="text-[11px] font-semibold uppercase tracking-[0.22em] text-neutral-400">
                            Sesion administrativa
                          </p>
                          <p className="mt-2 text-lg font-semibold text-neutral-950">{adminUser.name}</p>
                          <p className="mt-1 text-sm text-neutral-500">
                            Acceso activo para supervision, control y configuracion.
                          </p>
                        </div>
                        <span className="rounded-full bg-emerald-100 px-3 py-1.5 text-xs font-semibold text-emerald-700">
                          Activa
                        </span>
                      </div>

                      <div className="mt-4 grid gap-3 sm:grid-cols-2">
                        <InfoRow label="Usuario" value={adminUser.phone} />
                        <InfoRow label="Region" value={adminUser.region} />
                      </div>
                    </div>
                  </div>

                  <div className="mt-4 grid gap-3 sm:grid-cols-3">
                    <MetricCard label="Total cargados" value={summary.total.toString()} />
                    <MetricCard label="Activos" value={summary.active.toString()} />
                    <MetricCard label="Delivery propio" value={summary.ownDelivery.toString()} />
                  </div>
                </section>

                <section className="grid gap-4 xl:grid-cols-[1.15fr_0.85fr]">
                  <PanelCard title="Lectura operativa" subtitle="Estado general">
                    <div className="grid gap-3 sm:grid-cols-2">
                      <InfoRow label="Administrador" value={adminUser.name} />
                      <InfoRow label="Rol" value={adminUser.role} />
                      <InfoRow label="Restaurantes en pantalla" value={String(restaurants.length)} />
                      <InfoRow label="Regiones detectadas" value={String(regions.length)} />
                    </div>
                    <div className="mt-4 rounded-[24px] border border-black/5 bg-[#f8f7f4] p-4 text-sm leading-7 text-neutral-600">
                      El panel ya esta listo para continuar con el rediseño por secciones. Desde aqui podremos profundizar dashboard, restaurantes, repartidores, usuarios y configuracion sin perder orden estructural.
                    </div>
                  </PanelCard>

                  <PanelCard title="Alertas del sistema" subtitle="Mensajes de sesion">
                    <div className="grid gap-3">

                      {error ? <Callout tone="danger">{error}</Callout> : null}
                      {!authMessage && !error ? (
                        <EmptyState text="No hay alertas ni bloqueos activos en esta sesion administrativa." compact />
                      ) : null}
                    </div>
                  </PanelCard>
                </section>
              </div>
            ) : null}

            {activeSection === 'restaurants' ? (
              <div className="space-y-6">
                <section className="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
                  <MetricCard
                    label="Restaurantes totales"
                    value={String(restaurantOverview?.totalRestaurants || summary.total)}
                    detail="Base completa registrada"
                  />
                  <MetricCard
                    label="Con deuda activa"
                    value={String(restaurantOverview?.restaurantsWithDebt || 0)}
                    detail="Requieren seguimiento de cobro"
                  />
                  <MetricCard
                    label="Deuda total"
                    value={formatCurrency(restaurantOverview?.totalOutstandingDebt || 0)}
                    detail="Uso de plataforma pendiente"
                  />
                  <MetricCard
                    label="Ciclo dominante"
                    value={
                      (restaurantOverview?.weeklyBillingRestaurants || 0) >=
                      (restaurantOverview?.monthlyBillingRestaurants || 0)
                        ? 'Semanal'
                        : 'Mensual'
                    }
                    detail="Configuracion mas usada"
                  />
                </section>

                <div className="flex justify-end">
                  <button
                    type="button"
                    onClick={openCreateRestaurantModal}
                    className="rounded-full bg-neutral-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-neutral-800"
                  >
                    Agregar restaurant +
                  </button>
                </div>

                <PanelCard
                  title="Filtro de restaurantes"
                  subtitle="Búsqueda y cobertura"
                  aside={loading ? 'Actualizando' : `${restaurants.length} registros`}
                >
                  <form onSubmit={loadRestaurants} className="grid gap-3 lg:grid-cols-[minmax(0,1.5fr)_repeat(2,minmax(0,0.8fr))]">
                    <Field
                      label="Búsqueda"
                      value={restaurantFilters.search}
