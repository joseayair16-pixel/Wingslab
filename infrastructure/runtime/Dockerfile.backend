# No external Dockerfile frontend, package installer, lifecycle hooks or network.
# Context is generated by scripts/wingslab-stage-backend.py from verified tarballs.
ARG WINGSLAB_NODE_IMAGE=wingslab-node@sha256:75c03198160d884d61ac1609ae3895d10932c0c4a339f4fa4881bb67628123f5
FROM ${WINGSLAB_NODE_IMAGE} AS compatible-node
# Prisma 5 detects Alpine libssl under /lib, not Alpine 3.24's /usr/lib.
# Reuse the existing verified library, without installing or replacing binaries.
RUN --network=none test -f /usr/lib/libssl.so.3 && test ! -e /lib/libssl.so.3 \
    && ln -s /usr/lib/libssl.so.3 /lib/libssl.so.3

FROM compatible-node AS build
WORKDIR /app
ENV CHECKPOINT_DISABLE=1 PRISMA_HIDE_UPDATE_MESSAGE=1 PRISMA_SKIP_POSTINSTALL_GENERATE=1
COPY . .
RUN --network=none node node_modules/typescript/bin/tsc -p packages/shared/tsconfig.json
RUN --network=none \
    PRISMA_QUERY_ENGINE_LIBRARY=/app/node_modules/@prisma/engines/libquery_engine-linux-musl-arm64-openssl-3.0.x.so.node \
    PRISMA_SCHEMA_ENGINE_BINARY=/app/node_modules/@prisma/engines/schema-engine-linux-musl-arm64-openssl-3.0.x \
    node node_modules/prisma/build/index.js generate --schema packages/backend/prisma/schema.prisma
RUN --network=none node node_modules/typescript/bin/tsc -p packages/backend/tsconfig.json \
    && node node_modules/tsc-alias/dist/bin/index.js -p packages/backend/tsconfig.json
RUN --network=none node node_modules/jest/bin/jest.js --config packages/backend/jest.hermetic.config.cjs --runInBand
RUN --network=none node -e "require('fs').writeFileSync('wingslab-build.json', JSON.stringify({freshBuild:true,source:'sri-verified-backend-context',role:'backend'}))"

FROM compatible-node AS runtime
WORKDIR /app
ENV NODE_ENV=production CHECKPOINT_DISABLE=1
LABEL org.wingslab.project=wingslab org.wingslab.phase=2c org.wingslab.role=backend
COPY --from=build --chown=1000:1000 /app/package.json /app/wingslab-build.json /app/provision-manifest.json ./
COPY --from=build --chown=1000:1000 /app/production-deps/node_modules ./node_modules
COPY --from=build --chown=1000:1000 /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=build --chown=1000:1000 /app/config/wingslab.cjs ./config/wingslab.cjs
COPY --from=build --chown=1000:1000 /app/scripts/wingslab-run.cjs /app/scripts/blocked-operation.cjs ./scripts/
COPY --from=build --chown=1000:1000 /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build --chown=1000:1000 /app/packages/shared/dist ./packages/shared/dist
COPY --from=build --chown=1000:1000 /app/packages/shared/src/wingslab-policy.cjs ./packages/shared/src/wingslab-policy.cjs
COPY --from=build --chown=1000:1000 /app/packages/backend/package.json ./packages/backend/package.json
COPY --from=build --chown=1000:1000 /app/packages/backend/dist ./packages/backend/dist
USER 1000:1000
# Explicitly inert: no server or job starts when the image is run accidentally.
CMD ["node", "scripts/blocked-operation.cjs"]
