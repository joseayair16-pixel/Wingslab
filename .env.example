# SaDeL Environment Variables

## Node Environment
NODE_ENV=development
# ALLOW_MOCK_OTP_IN_PROD is only relevant to legacy SMS/profile phone-change code delivery.
# ALLOW_MOCK_OTP_IN_PROD=false

## API Configuration
PORT=3001
API_HOST=0.0.0.0
API_URL=http://localhost:3001

## Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_TYPE=admin

## Database
# For direct connection (default): use connection_limit=20 for higher concurrency
# DATABASE_URL=postgresql://sadel_user:sadel_password_dev@localhost:5432/sadel_db?connection_limit=20
#
# For PgBouncer (recommended for production with >500 concurrent users):
# Use pooled connection mode with pgbouncer=true
# DATABASE_URL=postgresql://sadel_user:sadel_password_dev@localhost:5432/sadel_db?pgbouncer=true&connection_limit=25&pool_timeout=10
#
# Railway Postgres: Use the internal connection string they provide (non-pooled)
# Railway Postgres + PgBouncer addon: Use the pooled URL from the PgBouncer addon
DATABASE_URL=postgresql://sadel_user:sadel_password_dev@localhost:5432/sadel_db

## Redis
REDIS_URL=redis://localhost:6379

## JWT
JWT_SECRET=your_secret_key_change_in_production_immediately
JWT_EXPIRES_IN=24h

## Cifrado de datos sensibles (cuentas bancarias de repartidores/restaurantes)
# Clave DEDICADA, separada de JWT_SECRET (no reutilizar el mismo secreto entre
# firmas HS256 y cifrado AES-256-GCM). Requerida en producción (obligatoria).
# Genera una con: `openssl rand -hex 32`
DATABASE_ENCRYPTION_KEY=your_database_encryption_key_change_in_production
# Opcional, para rotación: claves históricas separadas por coma. Permiten
# descifrar datos cifrados con una clave anterior; nunca se usan para cifrar.
# DATABASE_ENCRYPTION_KEYS=clave_anterior_1,clave_anterior_2

## CORS
CORS_ORIGIN=*

## Payment Gateway (Placeholder - implement with your provider)
PAYMENT_GATEWAY_KEY=your_payment_key
PAYMENT_GATEWAY_SECRET=your_payment_secret

## Logging
LOG_LEVEL=info

## Email delivery
# SMTP remains available for account and service emails. It is not used to verify
# customer registration or password recovery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=SaDeL <no-reply@sadel.mx>

## SMS (360NRS) — used when a signed-in customer changes their phone number
# Usuario y apiPassword de la sección API de 360NRS (dashboard.360nrs.com)
SMS_360NRS_USER=your_360nrs_user
SMS_360NRS_PASSWORD=your_360nrs_api_password
# Remitente que ve el usuario (máx. 11 alfanuméricos o 15 numéricos)
SMS_360NRS_FROM=SADEL
# Solo si tu cuenta usa otro host (raro); por defecto dashboard.360nrs.com
# SMS_360NRS_HOST=https://dashboard.360nrs.com

## Autenticación de comensales
# Registro y recuperación se confirman con un mensaje entrante al WhatsApp de SaDeL.
# No se envía OTP por correo. SMS_360NRS queda para verificar cambios de teléfono.
# ALLOW_MOCK_OTP_IN_PROD=false

## AWS S3 (Optional - for image storage)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=sadel-uploads

## Cloudflare R2 (Image storage - recommended over Cloudinary)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=sadel-images
R2_PUBLIC_URL=https://images.sadel.mx  # Optional, falls back to r2.dev domain if not set

## Cloudflare Workers AI (AI image generation - FLUX schnell, free tier - Optional)
# Token de API con permiso "Workers AI" (My Profile -> API Tokens -> Create Token -> Workers AI)
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_workers_ai_api_token
# Tope diario de imagenes por restaurante (default: 25). El free tier de Workers AI
# permite ~10k neuronas/dia (~50 imagenes); sin estas variables el boton devuelve 503.
AI_IMAGE_DAILY_CAP=25

## WhatsApp Integration (Optional)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_account_id
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_TOKEN=your_api_token
# Número público de WhatsApp Business con lada de México, por ejemplo 525512345678.
WHATSAPP_AUTH_PHONE=525512345678
# Token de verificación del webhook y App Secret de Meta para validar la firma.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_WEBHOOK_APP_SECRET=your_meta_app_secret
# URL del panel del restaurante (web-restaurant) para los links de las notificaciones de WhatsApp
RESTAURANT_PANEL_URL=https://restaurante.pideloporsadel.app

## Captura temporal de WhatsApp (emergencia, apagada por defecto)
# NO es una bandeja de entrada. Retiene en Redis (cifrado, TTL <= 10 min) los
# mensajes de TEXTO entrantes del número autorizado para recuperar un código de
# verificación. Se activa y se apaga por variable de entorno; NO requiere
# migraciones ni cambios en el webhook de Meta.
# Apagada por defecto. Debe ser exactamente "true" para activarse.
WHATSAPP_CAPTURE_ENABLED=false
# phone_number_id de Meta del número que puede ser capturado (obligatorio).
WHATSAPP_CAPTURE_PHONE_NUMBER_ID=your_phone_number_id
# Clave DEDICADA (>=16 caracteres). Debe ser distinta de DATABASE_ENCRYPTION_KEY
# y de JWT_SECRET; si coincide con alguna, la captura se rechaza.
WHATSAPP_CAPTURE_ENCRYPTION_KEY=genera_una_clave_aleatoria_de_32_bytes
# Vigencia de cada mensaje capturado (segundos). Tope duro: 600 (10 minutos).
WHATSAPP_CAPTURE_TTL_SECONDS=600
# Cupo máximo de mensajes retenidos. Tope duro: 50.
WHATSAPP_CAPTURE_MAX_MESSAGES=10

## URL base del frontend (para redes sociales / Open Graph)
NEXT_PUBLIC_SITE_URL=https://pideloporsadel.app

# ORIGEN CANÓNICO DE LA APP DEL COMENSAL (usa en links para compartir tienda, QR de reparto, etc.)
# ⚠️ CRÍTICO: jamas apuntar a un preview de Vercel (*.vercel.app) ni a sadel.app.
# - Backend lee CUSTOMER_WEB_URL (o WEBAPP_URL) para generar QR / links de WhatsApp.
# - web-restaurant lee NEXT_PUBLIC_CUSTOMER_URL para "Copiar link" de la tienda.
CUSTOMER_WEB_URL=https://pideloporsadel.app
WEBAPP_URL=https://pideloporsadel.app
NEXT_PUBLIC_CUSTOMER_URL=https://pideloporsadel.app

## Geolocation & Maps
MAPBOX_TOKEN=your_mapbox_token
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key
