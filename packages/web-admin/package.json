{
  "name": "@sadel/web-admin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next .next-dev .next-build tsconfig.tsbuildinfo",
    "clean:dev": "rm -rf .next .next-dev",
    "clean:build": "rm -rf .next-build",
    "dev": "npm run clean:dev && next dev -p 3000",
    "build": "npm run clean:build && next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@sadel/shared": "1.0.0",
    "axios": "^1.6.5",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3",
    "socket.io-client": "^4.7.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "postcss": "^8.4.32"
  }
}
