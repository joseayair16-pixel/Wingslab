{
  "name": "@sadel/backend",
  "version": "1.0.0",
  "description": "SaDeL Backend API - Fastify + Node.js",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed:billing-demo": "tsx src/scripts/seed-billing-demo.ts",
    "db:studio": "prisma studio",
    "db:backup": "pg_dump $(grep -o 'postgresql://[^ ]*' .env | head -1) > backups/sadel_$(date +%Y%m%d_%H%M%S).sql",
    "test": "jest",
    "test:http": "jest src/routes/http.integration.test.ts",
    "test:flow": "jest src/routes/order-lifecycle.integration.test.ts",
    "test:failures": "jest src/routes/order-failures.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1094.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/client": "^5.7.1",
    "@sadel/shared": "1.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.12.3",
    "firebase-admin": "^14.2.0",
    "ioredis": "^5.3.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.4",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "jest": "^29.7.0",
    "prisma": "^5.7.1",
    "ts-jest": "^29.1.1",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
